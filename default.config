#!/bin/bash
# shellcheck disable=SC2034
#! Do not edit this file directly, instead create a new file with the name of the streamer you want to record. (e.g: asmongold.config)
set -a

#=============================================================================
# AutoVOD 3.x configuration
#
# Every 2.x setting still works exactly as before, this file only adds new
# optional ones.  The file is read by autovod.py with a bash-subset parser -
# it is NOT executed, so it can neither run code nor break your shell.
#=============================================================================

#* Source
STREAM_SOURCE="twitch"            #* Options: twitch, kick, youtube
STREAMER_CHANNEL=""               #? Optional: channel to record when it differs from the config name
STREAM_URL=""                     #? Optional: full URL, overrides STREAM_SOURCE/STREAMER_CHANNEL (any streamlink site)

#* Upload provider
UPLOAD_SERVICE="youtube"          #* Options: youtube, rclone, restream, local

#* Stream metadata (comes from streamlink itself - no external API needed)
API_CALLS="false"                 #? DEPRECATED 2.x option, kept so old configs keep working
API_URL=""                        #? DEPRECATED 2.x option (only used as a title fallback)
#? Placeholders for VIDEO_TITLE, VIDEO_DESCRIPTION, VIDEO_PLAYLIST, RCLONE_FILENAME, LOCAL_FILENAME:
#?   {{TITLE}}    {{GAME}}     - stream title / game (from streamlink metadata)
#?   {{STREAMER}} {{ID}}       - streamer name / stream id
#?   {{DATE}}     {{TIME}}     - date / time, formatted with DATE_FORMAT and CLOCK_FORMAT
#?   {{PART}}                  - current part number
#?   TIME_DATE, TIME_CLOCK, $STREAMER_TITLE, $STREAMER_GAME, $STREAMER_NAME - 2.x style, still supported
DATE_FORMAT="%d-%m-%y"            #? strftime format used for {{DATE}} / TIME_DATE
CLOCK_FORMAT="%H_%M_%S"           #? strftime format used for {{TIME}} / TIME_CLOCK

#* Streamlink settings (valid for all upload providers)
STREAMLINK_QUALITY="best"          #* Options: worst, 360p, 480p, 720p, 720p60, 1080p60, best
QUALITY_FALLBACK="best"            #? Used when the requested quality is not offered (streamlink gets "1080p60,best")
STREAMLINK_FLAGS=("--twitch-supported-codecs=h264,h265,av1") #? Extra streamlink arguments (array, not a string)
STREAMLINK_EXTRA_ARGS=()           #? Additional streamlink arguments, appended after STREAMLINK_FLAGS
STREAMLINK_LOGS="error"            #* Options: none, error, warning, info, debug, trace, all
STREAMLINK_RETRY_STREAMS="2"       #? Seconds between retries while waiting for a stream
STREAMLINK_RETRY_MAX="3"           #? Give up after this many streamlink retries
STREAMLINK_RETRY_OPEN="3"          #? Retries for opening the stream
STREAMLINK_STREAM_TIMEOUT="60"     #? Abort when no data arrives for this many seconds
STREAMLINK_HLS_LIVE_EDGE="0"       #? 0 = streamlink default, 1-3 for low latency
STREAMLINK_BIN=("streamlink")      #? Binary (or command + args) to use, e.g. ("/opt/venv/bin/streamlink")

#* Universal upload settings (valid for all upload providers)
VIDEO_DURATION="12:00:00"          #? XX:XX:XX, "30m" or "1h30m" (YouTube allows 12 hours per video)
SPLIT_INTO_PARTS="false"           #? Split the recording into parts (VIDEO_DURATION is ignored then)
SPLIT_VIDEO_DURATION="06:00:00"    #? Length of each part (XX:XX:XX)
SAVE_ON_FAIL="false"               #? Keep the file when an upload/re-encode fails
RECONNECT_MAX="5"                  #? Reconnect attempts when the stream drops mid-recording
RECONNECT_DELAY="10"               #? Seconds before the first reconnect (grows per attempt)
UPLOAD_RETRY_MAX="3"               #? Upload attempts per part before giving up
POLL_INTERVAL="60"                 #? Seconds between "is the stream live?" checks
POLL_INTERVAL_MAX="300"            #? Upper bound of the offline backoff
POLL_BACKOFF="true"                #? Increase the poll interval while the stream stays offline
LOCK="true"                        #? Refuse to start twice for the same streamer
STATE_DIR=".autovod"               #? Per-streamer state (part counter, lock)
TEMP_DIR="tmp"                     #? Working directory for parts/segments
LOG_LEVEL="info"                   #* Options: none, error, warning, info, debug
LOG_FILE=""                        #? Optional log file, e.g. "logs/$STREAMER_NAME.log" (rotated)
LOG_MAX_MB="10"                    #? Rotate the log file at this size
LOG_BACKUPS="3"                    #? How many rotated log files to keep
DISCORD_WEBHOOK=""                 #? Optional Discord webhook for notifications
NOTIFY_ON=("error")                #? Events to notify about: start, end, error

#* YouTube upload settings (only valid if UPLOAD_SERVICE is set to youtube)
VIDEO_TITLE="$STREAMER_NAME - TIME_DATE"                      #? Title of the video
VIDEO_DESCRIPTION="Uploaded using $STREAMER_NAME - TIME_DATE" #? Description (use \n for newlines)
VIDEO_VISIBILITY="unlisted"                                    #* Options: unlisted, private, public
VIDEO_PLAYLIST="$STREAMER_NAME VODs"                           #? Playlist title, empty = no playlist
VIDEO_TAGS=""                                                  #? Comma separated tags
VIDEO_CATEGORY_ID=""                                           #? YouTube category id (e.g. 20 for Gaming)
VIDEO_LANGUAGE=""                                              #? e.g. "de" or "en"
VIDEO_MADE_FOR_KIDS=""                                         #? true/false, empty = not sent
VIDEO_META_EXTRA_JSON=""                                       #? Optional JSON file merged into the upload metadata
YOUTUBE_FILENAME="$STREAMER_NAME-TIME_DATE"                    #? Name of the locally buffered part
YOUTUBE_RECORD_TO_DISK="true"                                  #? true: record first, then upload (survives failures)
YOUTUBE_KEEP_LOCAL="false"                                     #? true: keep the local file after a successful upload
YOUTUBE_MIN_BYTES="1048576"                                    #? Warn when a part is smaller than this
YOUTUBE_RATELIMIT="0"                                          #? Upload rate limit in Kbit/s, 0 = unlimited
YOUTUBE_NOTIFY_SUBSCRIBERS=""                                  #? "true"/"false"/empty = youtubeuploader decides
YOUTUBE_SECRETS="client_secrets.json"                          #? OAuth client secrets (relative to this file)
YOUTUBE_TOKEN_CACHE="request.token"                            #? Cached OAuth token (relative to this file)
YOUTUBE_UPLOADER_BIN=("youtubeuploader")                       #? Binary (or command + args)

#* Rclone upload settings (only valid if UPLOAD_SERVICE is set to rclone)
RCLONE_REMOTE="remote-name"                            #? rclone remote to upload to
RCLONE_DIR=""                                          #? Directory on the remote
RCLONE_FILENAME="$STREAMER_NAME"_"TIME_DATE"           #? File name on the remote (no spaces)
RCLONE_FILEEXT="mkv"                                   #? File extension on the remote
RCLONE_FLAGS=()                                        #? Extra rclone arguments (e.g. ("--bwlimit" "8M"))
RCLONE_RETRIES="3"                                     #? rclone's own retry count
RCLONE_BIN=("rclone")                                  #? Binary (or command + args)

#* Re-Stream settings (only valid if UPLOAD_SERVICE is set to restream)
RTMPS_URL="rtmp://a.rtmp.youtube.com/live2/"
RTMPS_STREAM_KEY=""
AUDIO_BITRATE="128"                #? Audio bitrate in Kbit/s (128 or "128k"). 2.x used a sample rate here.
AUDIO_BITRATE_DEFAULT="128"        #? Bitrate used when AUDIO_BITRATE holds a legacy 2.x sample rate
AUDIO_SAMPLERATE="44100"           #? Audio sample rate in Hz (only used when AUDIO_BITRATE is a bitrate)
AUDIO_CHANNELS="2"                 #? Audio channels
AUDIO_CODEC="aac"
FILE_FORMAT="flv"
RESTREAM_VIDEO_CODEC="copy"        #? copy = no transcoding (recommended), or e.g. libx264
RESTREAM_FFMPEG_LOG="warning"      #? ffmpeg log level for the restream
RESTREAM_FORCE_KEYFRAMES="true"    #? Force keyframes when transcoding
RESTREAM_GOP="60"                  #? GOP size when transcoding

#* Local settings (only valid if UPLOAD_SERVICE is set to local)
LOCAL_FILENAME="$STREAMER_NAME"_"TIME_DATE"            #? File name of the local recording
LOCAL_EXTENSION="mkv"                                  #? File extension of the local recording
LOCAL_DIR=""                                           #? Optional directory (relative to this config file)

#* Re-Encoding settings (only works if UPLOAD_SERVICE is set to rclone or local)
#? Re-encodes the stream with ffmpeg. Only worth it on a server with a fast CPU: software
#? x265/AV1 encoding of a live 1080p60 stream needs a lot of it.
RE_ENCODE="false"                  #? Set to true to re-encode
RE_ENCODE_CODEC="libx265"          #* Options: libx265, libvpx-vp9, libaom-av1 (https://ffmpeg.org/ffmpeg-codecs.html)
RE_ENCODE_CRF="25"                 #* Options: 0-51 (lower is better quality, larger file) (https://slhck.info/video/2017/02/24/crf-guide.html)
RE_ENCODE_PRESET="medium"          #* Options: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
RE_ENCODE_AUDIO_CODEC="copy"       #? copy = keep the source audio (recommended), or aac/libopus
RE_ENCODE_LOG="error"              #* Options: none, error, warning, info, debug, trace, all
FFMPEG_BIN=("ffmpeg")              #? Binary (or command + args)

set +a
